{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "automerge": true,
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^makes\\/install\\.sh$/",
        "/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "(?:^|\\n)[^\\n]*\\bnpm\\s[^\\n]*\\binstall\\b[^\\n]*",
        "(?:^|\\s)(?<depName>(?:@[a-z0-9-]+/)?[a-z0-9._-]+)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
